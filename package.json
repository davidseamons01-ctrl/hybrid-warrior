{
  "name": "hybrid-warrior",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hybrid Training PWA — typed @core engine + vanilla PWA shell (overhaul in progress).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:core": "node scripts/build-core.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:core && npm run build:ui",
    "stamp": "node scripts/stamp.mjs",
    "deploy": "npm run build && npm run stamp",
    "test:artifact": "node test/programming.test.mjs",
    "test:integration": "node test/engine.integration.mjs && node test/eventsourcing.integration.mjs",
    "test:rules": "npx -y firebase-tools@13 emulators:exec --only firestore \"node test/firestore-rules.test.mjs\"",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:artifact && npm run test:integration"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "esbuild": "^0.24.0",
    "firebase": "^10.12.4",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "preact": "^10.29.2"
  }
}
