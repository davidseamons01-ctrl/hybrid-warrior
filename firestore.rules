rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
//  Hybrid Training — Firestore security rules.
//
//  ⚠️  RECONCILE BEFORE DEPLOYING. This repo did not previously version-control
//  rules, so the existing `hw` / `community` / `community_posts` sections below
//  are reconstructed from the app's access patterns. Diff against your live
//  console rules and TEST IN THE EMULATOR (`firebase emulators:start`) before
//  `firebase deploy --only firestore:rules`. Deploying replaces console rules.
//
//  The `partner_*` / `session_codes` sections are new (Partner Sessions, M2).
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Per-user app state (logs, settings, program). Private to its owner. ──
    match /hw/{uid} {
      allow read, write: if isUser(uid);
      match /{sub=**} { allow read, write: if isUser(uid); }
    }

    // ── Public community profile (handle, level, big-3 e1RM). Read by members. ──
    match /community/{uid} {
      allow read: if signedIn();
      allow write: if isUser(uid);
    }

    // ── Community feed. Anyone signed-in can read + heart; author owns the post. ──
    match /community_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow update: if signedIn(); // hearts (heartedBy) — author-id is immutable below
      allow delete: if signedIn() && request.auth.uid == resource.data.uid;
    }

    // ════════════════════════════════════════════════════════════════════════
    //  Partner Sessions (live co-op). See docs/partner-sessions.md §7–§8.
    // ════════════════════════════════════════════════════════════════════════

    // A short, TTL'd code that maps to a session. The code itself is the secret,
    // so any signed-in user who knows it may read; only the host creates/clears it.
    match /session_codes/{code} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.hostUid;
      allow delete: if signedIn() && request.auth.uid == resource.data.hostUid;
      allow update: if false;
    }

    // The live session doc. Session ids are unguessable randoms; the join code is
    // the real gate. Reads are allowed to any signed-in user (needed so a guest
    // can load the doc to join); creation is host-only; updates require that the
    // writer is a participant *after* the write (lets a guest add only themselves);
    // deletion is host-only.
    match /partner_sessions/{sessionId} {
      function isParticipantAfter() {
        return signedIn() && request.auth.uid in request.resource.data.participants;
      }
      function isParticipantNow() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      allow read:   if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.hostUid
                       && request.auth.uid in request.resource.data.participants;
      allow update: if isParticipantNow() || isParticipantAfter();
      allow delete: if signedIn() && request.auth.uid == resource.data.hostUid;

      // Live set feed — append-only, attributed to the writer; participants only.
      match /feed/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn()
                         && request.auth.uid == request.resource.data.uid
                         && request.auth.uid in get(/databases/$(database)/documents/partner_sessions/$(sessionId)).data.participants;
        allow update, delete: if false; // immutable
      }
    }

    // Invite inbox: only the owner reads/clears; a sender may drop an invite in.
    match /partner_invites/{uid}/items/{inviteId} {
      allow read, delete: if isUser(uid);
      allow create: if signedIn() && request.auth.uid == request.resource.data.fromUid;
      allow update: if false;
    }

    // Default deny.
    match /{document=**} { allow read, write: if false; }
  }
}
